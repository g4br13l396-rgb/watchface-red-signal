<?xml version="1.0" encoding="utf-8"?>
<!-- Red Signal - Watch Face Format v2 (Wear OS 5), 450x450 -->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Scene backgroundColor="#FF000000">

    <!-- ============================== MODALITA' ATTIVA ============================== -->
    <Group name="interactive" x="0" y="0" width="450" height="450">
      <Variant mode="AMBIENT" target="alpha" value="0"/>
      <PartImage x="0" y="0" width="450" height="450"><Image resource="background"/></PartImage>

      <!-- Onde animate dietro i passi: due strati che scorrono in versi opposti.
           Ogni striscia è larga 450 px + un periodo; spostandola di un periodo torna identica (ciclo continuo). -->
      <!-- strato tenue: verso destra, periodo 300 px ogni 10 s -->
      <PartImage x="-300" y="292" width="750" height="158">
        <Transform target="x" value="-300 + ([SECOND_MILLISECOND] % 10) * 30"/>
        <Image resource="wave_b"/>
      </PartImage>
      <!-- strato principale: verso sinistra, periodo 180 px ogni 6 s -->
      <PartImage x="0" y="292" width="630" height="158">
        <Transform target="x" value="0 - ([SECOND_MILLISECOND] % 6) * 30"/>
        <Image resource="wave_a"/>
      </PartImage>
      <!-- mirini, scanner, etichetta e binario dei passi, tacche: sopra le onde -->
      <PartImage x="0" y="0" width="450" height="450"><Image resource="foreground"/></PartImage>

      <!-- Ora HH:MM: una immagine per cifra, visibile solo quella giusta -->
      <PartImage x="52" y="132" width="72" height="104"><Transform target="alpha" value="floor([HOUR_0_23] / 10) == 0 ? 255 : 0"/><Image resource="d0"/></PartImage>
      <PartImage x="52" y="132" width="72" height="104"><Transform target="alpha" value="floor([HOUR_0_23] / 10) == 1 ? 255 : 0"/><Image resource="d1"/></PartImage>
      <PartImage x="52" y="132" width="72" height="104"><Transform target="alpha" value="floor([HOUR_0_23] / 10) == 2 ? 255 : 0"/><Image resource="d2"/></PartImage>
      <PartImage x="52" y="132" width="72" height="104"><Transform target="alpha" value="floor([HOUR_0_23] / 10) == 3 ? 255 : 0"/><Image resource="d3"/></PartImage>
      <PartImage x="52" y="132" width="72" height="104"><Transform target="alpha" value="floor([HOUR_0_23] / 10) == 4 ? 255 : 0"/><Image resource="d4"/></PartImage>
      <PartImage x="52" y="132" width="72" height="104"><Transform target="alpha" value="floor([HOUR_0_23] / 10) == 5 ? 255 : 0"/><Image resource="d5"/></PartImage>
