      <!-- Data: giorno della settimana, giorno, mese -->
      <PartText x="160" y="90" width="190" height="30">
        <Text align="START"><Font family="roboto_cond_semibold" size="22" color="#FF28D728"><Upper><Template>%s %d %s<Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[DAY]"/><Parameter expression="[MONTH_S]"/></Template></Upper></Font></Text>
      </PartText>
      <!-- Secondi -->
      <PartText x="340" y="90" width="38" height="30">
        <Text align="END"><Font family="roboto_cond_semibold" size="13" color="#FFF02818"><Template>SEC</Template></Font></Text>
      </PartText>
      <PartText x="372" y="90" width="32" height="30">
        <Text align="END"><Font family="roboto_cond_semibold" size="22" color="#FF28D728"><Template>%02d<Parameter expression="[SECOND]"/></Template></Font></Text>
      </PartText>

      <!-- Batteria: barra piena rossa + maschera a strisce sopra -->
      <PartDraw x="0" y="0" width="450" height="450">
        <Rectangle x="112" y="262" width="200" height="14">
          <Transform target="width" value="200 * clamp([BATTERY_PERCENT], 0, 100) / 100.0"/>
          <Fill color="#FFF02818"/>
        </Rectangle>
        <!-- barra passi (piena a 10.000) -->
        <Rectangle x="140" y="382" width="170" height="5">
          <Transform target="width" value="170 * clamp([STEP_COUNT] / 10000.0, 0, 1)"/>
          <Fill color="#FF28D728"/>
        </Rectangle>
      </PartDraw>
      <PartImage x="112" y="262" width="200" height="14"><Image resource="stripe_mask"/></PartImage>
      <PartText x="326" y="253" width="80" height="32">
        <Text align="CENTER"><Font family="roboto_cond_semibold" size="22" color="#FFF02818"><Template>%d%%<Parameter expression="[BATTERY_PERCENT]"/></Template></Font></Text>
      </PartText>

      <!-- Passi -->
      <PartText x="125" y="324" width="200" height="54">
        <Text align="CENTER"><Font family="roboto_cond_semibold" size="40" color="#FF28D728"><Template>%d<Parameter expression="[STEP_COUNT]"/></Template></Font></Text>
      </PartText>
    </Group>

